    { "name": "Track MRO", "type": "Viewpoint", "center": "MRO", "distance": 3000, "latitude": 30, "longitude": 0 },
    {
      "name": "Sun", "class": "star",
      "trajectory": { "type": "FixedPoint", "position": [0, 0, 0] },
