    "pck00011_n0066.tpc",
    { "url": "../../kernels/de440s.bsp", "label": "Planets (de440s)", "size": 32000000 },
    { "url": "../../kernels/mar097_2020_2040.bsp", "label": "Mars system (mar097)", "size": 46000000 },
    { "url": "../../kernels/mro_psp.bsp", "label": "MRO trajectory (mro_psp)", "size": 164000000 }
  ],
  "items": [
